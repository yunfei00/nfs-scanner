/* Dark Professional theme for the commercial UI shell. */

QMainWindow#commercialMainShell,
QWidget#commercialRoot,
QMainWindow#commercialMainShell QWidget {
    background-color: #0B1220;
    color: #E8EEF8;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 12px;
}

/* --- Shell regions --- */

QWidget#commercialToolbar {
    background-color: #111A2B;
    border: 1px solid #2A3A52;
    border-radius: 8px;
}

QWidget#commercialToolbarPrimary {
    background-color: transparent;
}

QWidget#commercialToolbarSecondary {
    background-color: transparent;
}

QToolButton#commercialToolbarOverflow {
    background-color: #172235;
    color: #E8EEF8;
    border: 1px solid #2A3A52;
    border-radius: 6px;
    min-height: 28px;
    padding: 2px 10px;
}

QScrollArea#commercialDeviceScroll {
    background-color: transparent;
    border: none;
}

QLabel#commercialStatusChip {
    color: #8FA0B8;
    font-size: 9px;
    padding: 0 1px;
}

QWidget#commercialStatusBar {
    background-color: #0D1524;
    border: 1px solid #243247;
    border-radius: 4px;
}

QWidget#commercialBottomDock,
QWidget#commercialPropertyPanel,
QWidget#commercialWorkflowPanel,
QWidget#commercialDeviceStatusPanel,
QFrame#commercialLeftArea,
QFrame#nfsPanel,
QWidget#nfsDockPanel {
    background-color: #111A2B;
    border: 1px solid #2A3A52;
    border-radius: 8px;
}

QWidget#commercialBottomDock {
    border-radius: 8px;
}

QWidget#dockTabPage {
    background-color: transparent;
}

QFrame#dockStatPanel {
    background-color: #172235;
    border: 1px solid #243247;
    border-radius: 6px;
}

QLabel#dockStatTitle {
    color: #E8EEF8;
    font-size: 13px;
    font-weight: 600;
}

QLabel#dockStatValue {
    color: #E8EEF8;
    font-size: 14px;
    font-weight: 700;
}

/* --- Cards & collapsible panels --- */

QFrame#nfsCard,
QFrame#nfsCollapsiblePanel,
QFrame#commercialCard {
    background-color: #172235;
    border: 1px solid #2A3A52;
    border-radius: 8px;
}

QFrame#nfsCard:hover {
    background-color: #1D2B42;
}

/* --- Typography --- */

QLabel#nfsSectionTitle,
QLabel#commercialSectionTitle {
    color: #E8EEF8;
    font-size: 14px;
    font-weight: 600;
}

QLabel#nfsMutedLabel,
QLabel#commercialMutedLabel,
QLabel#commercialShellPlaceholder {
    color: #AAB7C8;
}

QLabel#nfsValueLabel,
QLabel#commercialValueLabel {
    color: #E8EEF8;
    font-weight: 600;
}

/* --- Buttons (NFS + legacy aliases) --- */

QPushButton {
    background-color: #172235;
    color: #E8EEF8;
    border: 1px solid #2A3A52;
    border-radius: 6px;
    min-height: 28px;
    padding: 2px 10px;
}

QPushButton:hover {
    background-color: #1D2B42;
}

QPushButton:pressed {
    background-color: #111A2B;
}

QPushButton:disabled {
    color: #69788D;
    background-color: #111A2B;
    border-color: #2A3A52;
}

QPushButton#nfsPrimaryButton,
QPushButton#primaryButton {
    background-color: #0EA5FF;
    border-color: #0EA5FF;
    color: #04111F;
    font-weight: 600;
}

QPushButton#nfsPrimaryButton:hover,
QPushButton#primaryButton:hover {
    background-color: #38B6FF;
}

QPushButton#nfsSecondaryButton,
QPushButton#secondaryButton {
    background-color: #172235;
    border-color: #2A3A52;
}

QPushButton#nfsDangerButton,
QPushButton#dangerButton {
    background-color: #EF4444;
    border-color: #EF4444;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#nfsDangerButton:hover,
QPushButton#dangerButton:hover {
    background-color: #F87171;
}

QToolButton#nfsToolButton,
QToolButton#ghostButton {
    background-color: transparent;
    border: none;
    color: #AAB7C8;
    min-height: 24px;
    padding: 0 4px;
    border-radius: 4px;
}

QToolButton#nfsToolButton:hover,
QToolButton#ghostButton:hover {
    color: #E8EEF8;
    background-color: #1D2B42;
}

/* --- Workflow steps --- */

QFrame#nfsWorkflowStep[active="true"],
QFrame#commercialWorkflowStep[active="true"] {
    background-color: #172235;
    border: 1px solid #0EA5FF;
    border-radius: 8px;
}

QFrame#nfsWorkflowStep[completed="true"] {
    background-color: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.35);
    border-radius: 8px;
}

QFrame#nfsWorkflowStep[active="false"][completed="false"] {
    background-color: rgba(105, 120, 141, 0.06);
    border: 1px solid transparent;
    border-radius: 8px;
}

QFrame#demoModeBanner {
    background-color: #1A2740;
    border: 1px solid #2A3A52;
    border-radius: 6px;
    max-height: 28px;
}

/* --- Custom frameless title bar --- */

/* --- Unified top header --- */

QFrame#commercialTopHeader {
    background-color: #0B1220;
    border-bottom: 1px solid #243247;
}

QWidget#commercialBrandArea {
    background-color: transparent;
}

QWidget#commercialBrandTextColumn {
    background-color: transparent;
}

QFrame#commercialBrandSeparator,
QFrame#commercialToolbarSeparator {
    background-color: #243247;
    max-width: 1px;
}

QWidget#commercialBrandRow {
    background-color: transparent;
}

QFrame#commercialTitleBar {
    background-color: #0B1220;
    border-bottom: 1px solid #243247;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QFrame#commercialTitleBarIcon {
    background-color: #0EA5FF;
    border-radius: 3px;
}

QLabel#commercialTitleBarDemo {
    color: #06D6E8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QToolButton#commercialTitleBarControl,
QToolButton#commercialTitleBarClose {
    background-color: transparent;
    color: #AAB7C8;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    min-height: 24px;
    padding: 0;
}

QToolButton#commercialTitleBarControl:hover {
    background-color: #1D2B42;
    color: #E8EEF8;
}

QToolButton#commercialTitleBarClose:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

QWidget#commercialContent {
    background-color: #0B1220;
}

QSizeGrip#commercialResizeGrip {
    width: 14px;
    height: 14px;
}

QLabel#demoModeBadge {
    color: #06D6E8;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(6, 214, 232, 0.12);
}

QLabel#demoModeRealBadge {
    color: #F59E0B;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(245, 158, 11, 0.12);
}

QPushButton#demoResetButton {
    min-height: 24px;
    padding: 2px 10px;
    font-size: 12px;
}

QFrame#nfsWorkflowStep,
QFrame#commercialWorkflowStep {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

/* --- Status badges --- */

QLabel#nfsStatusBadge[badgeStatus="connected"],
QLabel#statusBadgeConnected {
    color: #22C55E;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(34, 197, 94, 0.12);
}

QLabel#nfsStatusBadge[badgeStatus="disconnected"],
QLabel#statusBadgeDisconnected {
    color: #69788D;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(105, 120, 141, 0.12);
}

QLabel#nfsStatusBadge[badgeStatus="warning"],
QLabel#statusBadgeScanning {
    color: #F59E0B;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(245, 158, 11, 0.12);
}

QLabel#nfsStatusBadge[badgeStatus="running"] {
    color: #0EA5FF;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(14, 165, 255, 0.12);
}

QLabel#nfsStatusBadge[badgeStatus="error"],
QLabel#statusBadgeError {
    color: #EF4444;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(239, 68, 68, 0.12);
}

/* --- Inputs --- */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QPlainTextEdit,
QTextEdit {
    background-color: #172235;
    color: #E8EEF8;
    border: 1px solid #2A3A52;
    border-radius: 6px;
    min-height: 30px;
    padding: 4px 8px;
    selection-background-color: #0EA5FF;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #0EA5FF;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QCheckBox {
    spacing: 6px;
    color: #E8EEF8;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2A3A52;
    border-radius: 4px;
    background-color: #172235;
}

QCheckBox::indicator:checked {
    background-color: #0EA5FF;
    border-color: #0EA5FF;
}

/* --- Tabs (property panel + dock) --- */

QTabWidget::pane {
    border: 1px solid #2A3A52;
    border-radius: 8px;
    background-color: #111A2B;
    top: -1px;
}

QTabWidget#nfsDockTabs::pane,
QTabWidget#commercialBottomDockTabs::pane,
QTabWidget#commercialPropertyTabs::pane {
    border-top-left-radius: 0;
}

QTabBar::tab {
    background-color: #172235;
    color: #AAB7C8;
    border: 1px solid #2A3A52;
    border-bottom: none;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-height: 24px;
}

QTabBar::tab:selected {
    background-color: #111A2B;
    color: #0EA5FF;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #1D2B42;
    color: #E8EEF8;
}

/* --- Scroll & split --- */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: #172235;
    width: 14px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #3A5068;
    border: 1px solid #4A6580;
    border-radius: 6px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #4A6580;
    border-color: #5A7898;
}

QScrollBar::handle:vertical:pressed {
    background: #0EA5FF;
    border-color: #38BDF8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #172235;
    height: 14px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #3A5068;
    border: 1px solid #4A6580;
    border-radius: 6px;
    min-width: 28px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #4A6580;
    border-color: #5A7898;
}

QScrollBar::handle:horizontal:pressed {
    background: #0EA5FF;
    border-color: #38BDF8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QSlider::groove:horizontal {
    background: #243247;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #4A6580;
    border: 1px solid #5A7898;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #5A7898;
    border-color: #7A98B8;
}

QSlider::handle:horizontal:pressed {
    background: #0EA5FF;
    border-color: #38BDF8;
}

QSlider::groove:vertical {
    background: #243247;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #4A6580;
    border: 1px solid #5A7898;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background: #5A7898;
    border-color: #7A98B8;
}

QSlider::handle:vertical:pressed {
    background: #0EA5FF;
    border-color: #38BDF8;
}

QProgressBar {
    background: #172235;
    border: 1px solid #2A3A52;
    border-radius: 4px;
    height: 10px;
    text-align: center;
    color: #AAB7C8;
    font-size: 11px;
}

QProgressBar::chunk {
    background: #0EA5FF;
    border-radius: 3px;
}

QSplitter::handle {
    background-color: #2A3A52;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

/* --- Tables --- */

QTableWidget {
    background-color: #172235;
    alternate-background-color: #111A2B;
    gridline-color: #2A3A52;
    border: 1px solid #2A3A52;
    border-radius: 8px;
}

QHeaderView::section {
    background-color: #172235;
    color: #E8EEF8;
    border: 1px solid #2A3A52;
    padding: 6px;
    font-weight: 600;
}

/* --- Realtime canvas placeholder (legacy) --- */

QFrame#realtimeCanvasPlaceholder {
    background-color: #172235;
    border: 1px dashed #2A3A52;
    border-radius: 8px;
}

QPlainTextEdit#commercialLogView,
QPlainTextEdit#nfsLogView {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    background-color: #0B1220;
    border: 1px solid #243247;
    border-radius: 4px;
    padding: 4px 6px;
}

QListWidget#nfsDataTaskList,
QTableWidget#nfsDataTable {
    background-color: #172235;
    border: 1px solid #2A3A52;
    border-radius: 6px;
}

/* --- Realtime workspace assistive widgets --- */

QGraphicsView#realtimeCanvas {
    background-color: #0B1220;
    border: 1px solid #2A3A52;
    border-radius: 8px;
}

QWidget#nfsColorBar,
QWidget#commercialColorBar {
    background-color: #111A2B;
    border: 1px solid #2A3A52;
    border-radius: 8px;
}

QWidget#nfsMiniMap,
QWidget#commercialMiniMap {
    background-color: rgba(17, 26, 43, 0.88);
    border: 1px solid rgba(42, 58, 82, 0.45);
    border-radius: 6px;
}

QScrollArea#commercialLeftScroll {
    background-color: transparent;
    border: none;
}

/* --- Scan preview statistics --- */

QFrame#nfsCard[cardRole="previewStats"] {
    background-color: #1A2840;
    border: 1px solid #0EA5FF;
}

QLabel#nfsPreviewStatValue {
    color: #E8EEF8;
    font-size: 15px;
    font-weight: 700;
}

QLineEdit#nfsNumericInput[fieldState="invalid"] {
    border-color: #EF4444;
    background-color: #2A1820;
}

QLineEdit#nfsNumericInput[fieldState="valid"] {
    border-color: #2A3A52;
}

QLabel#nfsNumericUnit {
    color: #69788D;
    font-size: 12px;
    padding-left: 4px;
}

/* --- Target alignment: title bar brand --- */

QFrame#commercialTitleBarLogo {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0EA5FF, stop:1 #0284C7);
    border: 1px solid rgba(56, 182, 255, 0.45);
    border-radius: 8px;
}

QLabel#commercialTitleBarLogoText {
    color: #F8FAFC;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#commercialTitleBarTitle {
    color: #F1F5F9;
    font-size: 14px;
    font-weight: 700;
}

QLabel#commercialTitleBarSubtitle {
    color: #64748B;
    font-size: 11px;
    font-weight: 400;
}

QLabel#commercialTitleBarDemoStrip {
    color: #69788D;
    font-size: 9px;
    padding: 0 6px;
}

QLabel#commercialStatusDot {
    color: #22C55E;
    font-size: 9px;
    padding: 0;
}

QLabel#commercialTitleBarBadge {
    color: #38BDF8;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 4px;
    background-color: rgba(14, 165, 255, 0.12);
    border: 1px solid rgba(56, 189, 255, 0.35);
}

QWidget#commercialTopStatusArea {
    background-color: transparent;
}

QLabel#commercialTitleBarUserIcon {
    min-width: 14px;
    max-width: 14px;
}

QLabel#commercialTitleBarUserChevron {
    color: #64748B;
    font-size: 10px;
    padding-left: 0;
}

/* --- Workflow timeline --- */

QFrame#nfsWorkflowTimelineStep[active="true"] {
    background-color: rgba(14, 165, 255, 0.12);
    border: 1px solid rgba(14, 165, 255, 0.45);
    border-radius: 6px;
}

QFrame#nfsWorkflowTimelineStep[completed="true"] {
    background-color: rgba(34, 197, 94, 0.06);
    border: 1px solid transparent;
    border-radius: 6px;
}

QLabel#nfsWorkflowTimelineCircle {
    background-color: #172235;
    color: #AAB7C8;
    border: 1px solid #2A3A52;
    border-radius: 11px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#nfsWorkflowTimelineCircle[active="true"] {
    background-color: #0EA5FF;
    color: #04111F;
    border-color: #0EA5FF;
}

QLabel#nfsWorkflowTimelineCircle[completed="true"] {
    background-color: rgba(34, 197, 94, 0.20);
    color: #22C55E;
    border-color: rgba(34, 197, 94, 0.45);
}

QFrame#nfsWorkflowTimelineConnector {
    background-color: #2A3A52;
    min-height: 8px;
    max-height: 14px;
}

QLabel#nfsWorkflowTimelineTitle {
    color: #E8EEF8;
    font-size: 11px;
    font-weight: 600;
}

/* --- Icon toolbar --- */

QToolButton#commercialIconToolButton,
QToolButton#commercialIconToolPrimary,
QToolButton#commercialIconToolDanger,
QToolButton#commercialIconToolSuccess {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #94A3B8;
    font-size: 11px;
    padding: 2px 1px;
}

QToolButton#commercialIconToolButton:hover {
    background-color: #1D2B42;
    color: #E8EEF8;
}

QToolButton#commercialIconToolPrimary {
    background-color: rgba(14, 165, 255, 0.15);
    border-color: rgba(14, 165, 255, 0.35);
    color: #38B6FF;
}

QToolButton#commercialIconToolDanger {
    background-color: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.35);
    color: #F87171;
}

QToolButton#commercialIconToolSuccess {
    background-color: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.35);
    color: #4ADE80;
}

/* --- Compact property panel --- */

QFrame#nfsCompactSection {
    background-color: #172235;
    border: 1px solid #243247;
    border-radius: 6px;
}

QFrame#nfsPreviewStatsGrid {
    background-color: transparent;
}

QFrame#nfsPreviewStatCard {
    background-color: #172235;
    border: 1px solid #243247;
    border-radius: 6px;
}

QLabel#nfsPreviewStatValue {
    font-size: 13px;
}

/* --- Bottom dock tri-panel --- */

QWidget#commercialBottomDockTriPanel {
    background-color: transparent;
}

QFrame#commercialDockSpectrumPanel,
QFrame#commercialDockStatsPanel,
QFrame#commercialDockLogPanel {
    background-color: #172235;
    border: 1px solid #243247;
    border-radius: 6px;
}

QProgressBar#commercialScanProgressBar {
    background-color: #111A2B;
    border: 1px solid #2A3A52;
    border-radius: 4px;
    min-height: 14px;
    max-height: 16px;
    text-align: center;
    color: #E8EEF8;
    font-size: 10px;
}

QProgressBar#commercialScanProgressBar::chunk {
    background-color: #0EA5FF;
    border-radius: 3px;
}

/* --- Canvas HUD --- */

QFrame#canvasAxisLegend,
QFrame#canvasCursorHud {
    background-color: rgba(17, 26, 43, 0.88);
    border: 1px solid rgba(42, 58, 82, 0.55);
    border-radius: 6px;
}

QLabel#canvasAxisChip[axisColor="#EF4444"] {
    color: #EF4444;
    font-size: 11px;
    font-weight: 700;
}

QLabel#canvasAxisChip[axisColor="#22C55E"] {
    color: #22C55E;
    font-size: 11px;
    font-weight: 700;
}

QLabel#canvasAxisChip[axisColor="#3B82F6"] {
    color: #3B82F6;
    font-size: 11px;
    font-weight: 700;
}

QLabel#canvasCursorPos,
QLabel#canvasCursorRf {
    color: #E8EEF8;
    font-size: 10px;
}

QFrame#nfsMiniMapPanel {
    background-color: rgba(17, 26, 43, 0.88);
    border: 1px solid rgba(42, 58, 82, 0.45);
    border-radius: 6px;
}

QLabel#commercialMiniMapTitle {
    color: #AAB7C8;
    font-size: 10px;
    font-weight: 600;
}

QWidget#nfsMiniMap {
    background-color: transparent;
    border: none;
}

/* --- Target screenshot replication extras --- */

QWidget#commercialTitleBarAuth {
    background-color: transparent;
}

QLabel#commercialTitleBarAuthDot {
    color: #22C55E;
    font-size: 10px;
}

QLabel#commercialTitleBarAuthLabel,
QLabel#commercialTitleBarUser {
    color: #AAB7C8;
    font-size: 11px;
}

QToolButton#commercialIconToolSuccess {
    background-color: rgba(34, 197, 94, 0.14);
    border-color: rgba(34, 197, 94, 0.35);
    color: #4ADE80;
}

QLabel#nfsWorkflowTimelineProgress {
    color: #38B6FF;
    font-size: 10px;
    font-weight: 600;
}

QFrame#nfsWorkflowTimelineStep[active="true"] {
    background-color: rgba(14, 165, 255, 0.16);
    border: 1px solid rgba(56, 182, 255, 0.55);
    border-radius: 6px;
}

QLabel#canvasCursorTitle {
    color: #E8EEF8;
    font-size: 11px;
    font-weight: 600;
}

QWidget#commercialPropertyGridRow QLabel#nfsMutedLabel {
    font-size: 11px;
}

QLabel#commercialLogCategoryTag {
    font-size: 9px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    background-color: rgba(105, 120, 141, 0.18);
    color: #AAB7C8;
}

QLabel#commercialLogCategoryTag[logLevel="INFO"] {
    color: #38B6FF;
    background-color: rgba(56, 182, 255, 0.12);
}

QLabel#commercialLogCategoryTag[logLevel="WARN"] {
    color: #FBBF24;
    background-color: rgba(251, 191, 36, 0.12);
}

QLabel#commercialLogCategoryTag[logLevel="ERROR"] {
    color: #F87171;
    background-color: rgba(248, 113, 113, 0.12);
}

QLabel#commercialLogCategoryTag[logLevel="SCAN"] {
    color: #4ADE80;
    background-color: rgba(74, 222, 128, 0.12);
}

QLabel#commercialLogCategoryTag[logLevel="DATA"] {
    color: #A78BFA;
    background-color: rgba(167, 139, 250, 0.12);
}

QWidget#commercialToolbar {
    background-color: transparent;
    border: none;
    min-height: 48px;
    max-height: 48px;
}

QFrame#commercialTopHeader QFrame#commercialTitleBar {
    border-bottom: none;
}

QTabWidget#commercialPropertyTabs::pane {
    border: none;
    background-color: transparent;
}

QTabBar::tab {
    min-height: 24px;
    padding: 2px 10px;
    font-size: 11px;
}

QWidget#realtimeCanvasToolbar {
    background-color: #111A2B;
    border: 1px solid #243247;
    border-radius: 6px;
    padding: 2px;
}

QToolButton#realtimeCanvasToolButton {
    background-color: #172235;
    border: 1px solid #243247;
    border-radius: 3px;
    color: #AAB7C8;
    font-size: 9px;
    padding: 0 2px;
}
